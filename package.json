{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && npm run preview",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint:ts": "eslint src/**/*.ts",
    "lint:fix-ts": "eslint --fix src/**/*.ts",
    "lint:css": "stylelint src/**/*.css src/**/*.scss",
    "lint:fix-css": "stylelint --fix src/**/*.css src/**/*.scss",
    "lint": "npm run lint:ts && npm run lint:css",
    "test": "mocha",
    "prepare": "husky install"
  },
  "engines": {
    "node": "23.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/chai": "^5.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "chai": "^5.2.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "esm": "^3.2.25",
    "globals": "^16.1.0",
    "handlebars": "^4.7.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "mocha": "^11.7.1",
    "nanoid": "^5.1.5",
    "sinon": "^15.0.1",
    "sinon-chai": "^4.0.0",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^38.0.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite-plugin-handlebars": "^1.5.0"
  },
  "mocha": {
    "require": [
      "mochaSetup.js",
      "test-teardown.js"
    ],
    "exit": true
